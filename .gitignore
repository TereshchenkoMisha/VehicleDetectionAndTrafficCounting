# ---------------------------------------------------------------
# Project-specific
# ---------------------------------------------------------------
# Datasets (UA-DETRAC raw + converted YOLO store) - large, downloaded separately
/data/**
!/data/**/
!/data/**/.gitkeep

# Pretrained / trained weights (downloaded automatically by Ultralytics)
/models/
*.pt
*.pth
*.onnx
*.engine
*.torchscript
*.safetensors
*.ckpt

# Regenerable run results: tracks, annotated videos, previews.
# Small final tables live in reports/ and stay versioned.
/outputs/

# Debug / sanity images
reports/sanity/

# Ultralytics output folders created by YOLO train/val/predict runs
runs/

# Videos and large media produced by checks
*.mp4
*.avi
*.mov

# Personal review notes
.nocommit/

