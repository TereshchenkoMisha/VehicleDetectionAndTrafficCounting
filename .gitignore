# ---------------------------------------------------------------
# Project-specific
# ---------------------------------------------------------------
# Datasets (UA-DETRAC raw + converted YOLO store) - large, downloaded separately
/data/**
!/data/**/
!/data/**/.gitkeep

# Pretrained / trained weights (downloaded automatically by Ultralytics)
/models/
*.pt
*.pth
*.onnx
*.engine
*.torchscript
*.safetensors
*.ckpt

# Regenerable run results: tracks, annotated videos, tables and previews.
/outputs/

# Keep experiment inputs versioned; regenerate all other reports.
/reports/*
!/reports/splits.json
!/reports/ignored_regions.json
!/reports/counting_lines.json

# Ultralytics output folders created by YOLO train/val/predict runs
runs/

# Videos and large media produced by checks
*.mp4
*.avi
*.mov

# Personal review notes
.nocommit/

